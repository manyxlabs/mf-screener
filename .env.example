# ---- Data provider (TigZig AMFI NAV API) ----
MF_API_BASE=https://api.tigzig.com/mf/v1
MF_MASTER_FORMAT=latest.parquet
MF_NAV_FORMAT=parquet
MF_HTTP_TIMEOUT=180
MF_HTTP_RETRIES=5
MF_HTTP_BACKOFF=2.0
MF_USER_AGENT=mf-screener/0.1 (local research tool)
# A day-on-day NAV ratio beyond this is read as a scale change (a split or a merger)
# rather than a return, and truncates the window instead of inventing a spike.
MF_NAV_JUMP_RATIO=2.0

# ---- Expense ratio (TER) ----
# AMFI mandates daily TER disclosure but serves it per AMC behind a form, so this is a
# daily scrape of those pages. It covers part of the industry, not all of it: `make
# ter-import` prints the coverage it achieved and a fund it does not carry shows a
# blank expense ratio, never a zero. Point this at any CSV with the same headers.
MF_TER_CSV_URL=https://raw.githubusercontent.com/captn3m0/india-mutual-fund-ter-tracker/main/data.csv
# AMFI's own site. Read by `make data-aum-history` only, for the quarterly AAUM series.
MF_AMFI_BASE_URL=https://www.amfiindia.com

# ---- Bulk ingestion (DuckDB streaming limits) ----
# The full NAV history is 37M rows. It is scanned and written out by DuckDB, which
# spills to data/cache/duckdb-spill past this ceiling instead of exhausting RAM.
MF_DUCKDB_MEMORY_LIMIT=3GB
# 0 leaves DuckDB's own default (one thread per core).
MF_DUCKDB_THREADS=0

# ---- Local data lake ----
MF_DATA_DIR=./data
MF_DUCKDB_PATH=./data/processed/mf.duckdb

# ---- Capital gains tax on redemption (current as of the 2024-25 regime) ----
# Equity-oriented (equity, or a hybrid whose SEBI mandate fixes equity at 65%+):
# long-term gains above the exemption at the long-term rate past MF_LT_HOLDING_MONTHS,
# short-term rate below it. A rate change here is a config change, never a code change.
MF_LTCG_RATE=0.125
MF_LTCG_EXEMPTION=125000
MF_STCG_RATE=0.20
MF_LT_HOLDING_MONTHS=12
# Debt-oriented: taxed at the holder's slab rate regardless of holding period, for units
# acquired on or after 1 April 2023. This is an assumption about the holder the UI must
# state, never a property of the fund.
MF_SLAB_RATE=0.30

# ---- Analytics settings ----
MF_RISK_FREE_ANNUAL=0.065
MF_MONTH_END_TOLERANCE_DAYS=10
MF_MIN_ROLLING_WINDOWS=12
MF_MIN_PEERS=5
MF_METHODOLOGY_VERSION=1.0.0

# ---- Enrichment sources (Phase 3: third party, never a return/risk/ranking input) ----
# A separate, tighter budget than MF_HTTP_*, so a flaky enrichment source cannot slow
# down or fail the NAV ingest it has nothing to do with.
MF_ENRICH_HTTP_TIMEOUT=30
MF_ENRICH_HTTP_RETRIES=3
MF_ENRICH_HTTP_BACKOFF=2.0
# Past this many days since an enrichment row's as_of date, the UI labels it stale.
MF_ENRICH_STALE_DAYS=45
# The scheme-attributes source. Third party and unproven: see docs/data-policy.md. It is
# configurable so that swapping it does not need a code change, and so that pointing it
# at nothing is a supported state rather than a failure.
MF_ATTRIBUTES_SOURCE_URL=https://mfdata.in/api/v1
# The holdings source. Re-probed on 2026-09-12 and still returning HTTP 522, so nothing
# fetches from it: holdings arrive only through `make holdings-import FILE=...`. This
# key exists so the dormant adapter can be pointed somewhere the day one is reliable.
MF_HOLDINGS_SOURCE_URL=https://mfdata.in/api/v1

# ---- API / web ----
MF_API_HOST=127.0.0.1
MF_API_PORT=8000
MF_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_BASE=http://localhost:8000
