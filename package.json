{
  "name": "mf-screener",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --filter @mf/web dev",
    "build": "pnpm --filter @mf/shared build && pnpm --filter @mf/web build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css,md}\"",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "sharp"
    ]
  }
}
